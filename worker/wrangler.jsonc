{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texas-holdem-ws",
  "main": "dist/index.js",
  "compatibility_date": "2026-11-20",
  "durable_objects": {
    "bindings": [
      {
        "name": "POKER_ROOMS",
        "class_name": "PokerRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PokerRoom"]
    }
  ]
}
